# The E7 Parks server's staff API (server/ in the e7-parks repo).
# Local:      http://localhost:4000/api/staff
# Production: https://api.e7entertainments.com/api/staff (the default when unset)
E7_API_URL=http://localhost:4000/api/staff

# Time zone used to display dates. Defaults to India Standard Time.
DISPLAY_TIME_ZONE=Asia/Kolkata
